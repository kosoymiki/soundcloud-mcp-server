# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
# 127.0.0.1 is safest on a personal device; use 0.0.0.0 only behind TLS.
HOST=127.0.0.1
PUBLIC_URL=http://localhost:3000
# local = env/local token only, oauth = MCP authorization server, both = default.
MCP_MODE=both
# Return JSON instead of SSE for simple MCP clients (optional).
MCP_JSON_RESPONSE=false
# Trust X-Forwarded-* headers; only enable behind a trusted reverse proxy.
MCP_TRUST_PROXY=false

# ── SoundCloud application (per device, never commit) ────────────────────────
# Create an app at https://soundcloud.com/you/apps and register the redirect URI.
# The browser sign-in and the MCP OAuth flow both use these values.
SC_CLIENT_ID=
SC_CLIENT_SECRET=
SC_REDIRECT_URI=http://localhost:3000/soundcloud/callback
# Optional bootstrap for headless/local mode (short-lived unless a refresh token
# and client credentials are also present). Prefer the browser sign-in.
SC_ACCESS_TOKEN=
SC_REFRESH_TOKEN=
SC_ACCESS_TOKEN_EXPIRES_IN=3600
# Optional scope for the bootstrap token (default: all).
# SC_SCOPE=
# New SoundCloud apps use `OAuth`; legacy apps may need `Bearer`.
SC_AUTH_SCHEME=OAuth
SC_API_BASE=https://api.soundcloud.com
SC_AUTH_BASE=https://secure.soundcloud.com

# ── Security / storage ────────────────────────────────────────────────────────
DATA_DIR=~/.local/share/soundcloud-mcp
# 32-byte base64 key; generated into DATA_DIR/encryption.key (0600) when unset.
# MCP_ENCRYPTION_KEY=
# Only for MCP clients that cannot do OAuth; generated into DATA_DIR/local-token.
# MCP_LOCAL_TOKEN=
MCP_ACCESS_TOKEN_TTL=604800
MCP_REFRESH_TOKEN_TTL=2592000
MCP_SESSION_IDLE_TTL=1800
# Loopback requests reuse an existing local connection without a token.
MCP_PANEL_AUTO_LOGIN=true
# Allow open_auth_window / npm run auth to launch the OS browser.
MCP_OPEN_BROWSER=true

# ── Uploads ───────────────────────────────────────────────────────────────────
# Directories a tool/panel upload may read from (colon-separated).
SC_MEDIA_DIRS=~
# SoundCloud limit: 4 GB per file / 24 h of audio.
SC_MAX_UPLOAD_BYTES=4294967296

# ── Audio lab ─────────────────────────────────────────────────────────────────
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Allowed output directory for edits (default: DATA_DIR/edits).
# AUDIO_WORK_DIR=~/.local/share/soundcloud-mcp/edits
AUDIO_MAX_CONCURRENT=2

# ── Web-session uploads (no API app required) ────────────────────────────────
# Drives the real SoundCloud web uploader through a logged-in Chromium session.
# Cookies export: scripts/stealth-import-cookies.py (keep the JSON chmod 600).
SC_WEB_CHROME=chromium-browser
# SC_WEB_COOKIE_FILE=~/.local/share/soundcloud-mcp/chrome-soundcloud-cookies.json
SC_WEB_UPLOAD_URL=https://soundcloud.com/n/upload
SC_WEB_DEBUG_PORT=9333
SC_WEB_HEADLESS=true
SC_WEB_TIMEOUT_MS=90000
# SC_WEB_CLIENT_ID=
# Token endpoint used by `web-upload cookies --refresh`.
SC_WEB_TOKEN_URL=https://secure.soundcloud.com/oauth/token
# Explicit Chrome/Chromium Cookies database for `web-upload cookies`.
# CHROME_COOKIES_DB=/data/data/com.android.chrome/app_chrome/Default/Cookies
# Escape hatch: allow writing the cookie export inside a git work tree.
SC_ALLOW_COOKIES_IN_REPO=0
# Verbose web-session logs.
SC_WEB_VERBOSE=0

# ── UI / diagnostics ─────────────────────────────────────────────────────────
UI_BRAND_COLOR=#f50
MCP_DEBUG=false
LOG_LEVEL=info
